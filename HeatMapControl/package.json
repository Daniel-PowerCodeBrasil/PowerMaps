{
  "name": "powermaps-heatmapcontrol",
  "version": "1.3.0",
  "description": "PowerMaps HeatMapControl — a Power Apps Component Framework (PCF) virtual control that renders geolocated occurrences as an interactive Leaflet heat map or pin markers inside Canvas Apps.",
  "author": "Daniel (PowerCodeBrasil)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/daniel-powercodebrasil/powermaps.git"
  },
  "keywords": [
    "pcf",
    "powerapps",
    "power-platform",
    "canvas-apps",
    "heatmap",
    "leaflet",
    "maps",
    "geolocation",
    "dataverse"
  ],
  "scripts": {
    "build": "pcf-scripts build --buildMode production",
    "build:dev": "pcf-scripts build",
    "clean": "pcf-scripts clean",
    "rebuild": "pcf-scripts rebuild",
    "start": "pcf-scripts start",
    "start:watch": "pcf-scripts start watch",
    "refreshTypes": "pcf-scripts refreshTypes"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/powerapps-component-framework": "^1.3.15",
    "pcf-scripts": "^1",
    "pcf-start": "^1",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "typescript": "^4.9.5"
  }
}
