<?xml version="1.0" encoding="utf-8"?>
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace"/>
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="metadata">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0"/>
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string"/>
              <xsd:attribute name="type" type="xsd:string"/>
              <xsd:attribute name="mimetype" type="xsd:string"/>
              <xsd:attribute ref="xml:space"/>
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1"/>
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2"/>
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string"/>
              <xsd:attribute name="type" type="xsd:string"/>
              <xsd:attribute name="mimetype" type="xsd:string"/>
              <xsd:attribute ref="xml:space"/>
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <data name="HeatMapControl_DisplayName" xml:space="preserve"><value>Mapa de Calor</value></data>
  <data name="HeatMapControl_Description" xml:space="preserve"><value>Exibe ocorrências geolocalizadas como mapa de calor ou marcadores num mapa interativo.</value></data>
  <data name="occurrencesJson_DisplayName" xml:space="preserve"><value>Ocorrências (JSON)</value></data>
  <data name="occurrencesJson_Desc" xml:space="preserve"><value>Array JSON: [{"lat":-22.2,"lng":-49.9,"weight":1,"label":"..."}, ...]</value></data>
  <data name="enableHeatmap_DisplayName" xml:space="preserve"><value>Ativar Mapa de Calor</value></data>
  <data name="enableHeatmap_Desc" xml:space="preserve"><value>Quando ativo, exibe heatmap. Quando inativo, exibe marcadores.</value></data>
  <data name="heatRadius_DisplayName" xml:space="preserve"><value>Raio do Calor (px)</value></data>
  <data name="heatRadius_Desc" xml:space="preserve"><value>Raio em pixels do halo de cada ponto. Maior = pontos cobrem área maior. Default 50.</value></data>
  <data name="heatBlur_DisplayName" xml:space="preserve"><value>Desfoque (px)</value></data>
  <data name="heatBlur_Desc" xml:space="preserve"><value>Suavização das bordas do calor. Maior = bordas mais difusas. Default 25.</value></data>
  <data name="heatIntensity_DisplayName" xml:space="preserve"><value>Intensidade Máxima</value></data>
  <data name="heatIntensity_Desc" xml:space="preserve"><value>Número de pontos sobrepostos para atingir vermelho máximo. Menor = cores mais saturadas com poucos pontos. Default 3.</value></data>
  <data name="heatMaxZoom_DisplayName" xml:space="preserve"><value>Zoom de Intensidade Máxima</value></data>
  <data name="heatMaxZoom_Desc" xml:space="preserve"><value>Nível de zoom em que o heatmap atinge intensidade máxima.</value></data>
  <data name="initialLat_DisplayName" xml:space="preserve"><value>Latitude Inicial</value></data>
  <data name="initialLat_Desc" xml:space="preserve"><value>Latitude central inicial do mapa.</value></data>
  <data name="initialLng_DisplayName" xml:space="preserve"><value>Longitude Inicial</value></data>
  <data name="initialLng_Desc" xml:space="preserve"><value>Longitude central inicial do mapa.</value></data>
  <data name="initialZoom_DisplayName" xml:space="preserve"><value>Zoom Inicial</value></data>
  <data name="initialZoom_Desc" xml:space="preserve"><value>Nível de zoom inicial do mapa.</value></data>
  <data name="tileUrl_DisplayName" xml:space="preserve"><value>URL dos Tiles</value></data>
  <data name="tileUrl_Desc" xml:space="preserve"><value>URL do servidor de tiles. Vazio = OpenStreetMap padrão.</value></data>
</root>
