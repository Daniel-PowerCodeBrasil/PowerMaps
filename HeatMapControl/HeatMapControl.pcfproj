<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PowerAppsTargetsPath>$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps</PowerAppsTargetsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps\Microsoft.PowerApps.VisualStudio.Pcf.targets" Condition="Exists('$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps\Microsoft.PowerApps.VisualStudio.Pcf.targets')" />
  <PropertyGroup>
    <Name>HeatMapControl</Name>
    <ProjectGuid>f7a3b2c1-1234-5678-abcd-ef0123456789</ProjectGuid>
    <OutputPath>$(MSBuildThisFileDirectory)out\solutions\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Pcf" Version="1.*"/>
  </ItemGroup>
</Project>
