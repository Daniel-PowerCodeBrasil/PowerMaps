<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PowerAppsTargetsPath>$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps</PowerAppsTargetsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps\Microsoft.PowerApps.VisualStudio.Solution.targets" Condition="Exists('$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\PowerApps\Microsoft.PowerApps.VisualStudio.Solution.targets')" />

  <PropertyGroup>
    <SolutionPackageType>Unmanaged</SolutionPackageType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Other\Customizations.xml"/>
    <None Include="Other\Solution.xml"/>
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Solution" Version="1.*"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HeatMapControl\HeatMapControl.pcfproj"/>
  </ItemGroup>
</Project>
